{
  "name": "@chunhuizk/cloud",
  "version": "2.10.0",
  "description": "Chunhuicloud Javascript SDK",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunhuizk/chunhuicloud-sdk-javascript.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "aws-iot-device-sdk": "^2.2.16",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "mqtt": "^4.3.8"
  },
  "devDependencies": {
    "@types/aws-iot-device-sdk": "^2.2.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json",
    "test": "jest --config jestconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "npm-publish": "npm publish --registry https://registry.npmjs.org/"
  },
  "keywords": [
    "Chunhuicloud",
    "Chunhui",
    "Chunhuizk",
    "春晖智控"
  ],
  "author": "Mingtian Yang",
  "license": "ISC",
  "files": [
    "lib/**/*"
  ]
}
